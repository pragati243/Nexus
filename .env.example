# Copy to .env for local development. Never commit the real .env file.
# Local stack: docker compose brings up PostgreSQL + LocalStack (S3, SQS).
# No real AWS credentials are needed for local dev.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USERNAME=nexus_app
DB_PASSWORD=changeit-local-only

# --- AWS / LocalStack (local dev uses dummy values; real envs use IAM roles, not static keys) ---
AWS_REGION=ap-south-1
AWS_ENDPOINT_OVERRIDE=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- S3 ---
S3_RAW_IMPORTS_BUCKET=nexus-raw-imports-local

# --- SQS ---
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/nexus-ingestion-local
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/nexus-ingestion-dlq-local

# --- Auth (OIDC/JWT issuer used by Spring Security resource server) ---
# Only read when profile 'local'/'test' is NOT active (see
# com.nexus.security.OidcJwtDecoderConfig). Point these at a real OIDC
# provider (Auth0, Azure AD / Entra ID, Keycloak, Okta, ...) before running
# with any other profile — there is no fallback identity provider.
OIDC_ISSUER_URI=https://changeme.example.com/
OIDC_JWK_SET_URI=https://changeme.example.com/.well-known/jwks.json
OIDC_AUDIENCE=https://changeme.example.com/api

# --- CORS ---
# Comma-separated list of allowed browser origins. Empty by default — no
# wildcard, no cross-origin calls permitted until you explicitly list an
# origin here. Local frontend dev convenience values go in
# application-local.yml, not here.
CORS_ALLOWED_ORIGINS=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SPRING_PROFILES_ACTIVE=local
